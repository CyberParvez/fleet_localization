<?xml version="1.0"?>
<sdf version="1.8">
  <world name="asymmetric_indoor">
    <!-- Deliberately run at 0.2x so headless ROS bridges can preserve timestamp order. -->
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_update_rate>200</real_time_update_rate><real_time_factor>0.2</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction></light>
    <model name="floor"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>12 10 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 10 0.1</size></box></geometry><material><ambient>0.75 0.75 0.75 1</ambient></material></visual></link></model>
    <!-- Unequal wall lengths and offset internal obstacles make lidar poses unambiguous. -->
    <model name="walls"><static>true</static><link name="link">
      <collision name="north"><pose>0 5 0.5 0 0 0</pose><geometry><box><size>12 0.2 1</size></box></geometry></collision>
      <collision name="south"><pose>0 -5 0.5 0 0 0</pose><geometry><box><size>12 0.2 1</size></box></geometry></collision>
      <collision name="east"><pose>6 0 0.5 0 0 0</pose><geometry><box><size>0.2 10 1</size></box></geometry></collision>
      <collision name="west"><pose>-6 0 0.5 0 0 0</pose><geometry><box><size>0.2 10 1</size></box></geometry></collision>
      <collision name="long_partition"><pose>-2 1.8 0.5 0 0 0</pose><geometry><box><size>0.2 4.8 1</size></box></geometry></collision>
      <collision name="short_partition"><pose>2.5 -1.5 0.5 0 0 0.45</pose><geometry><box><size>3.2 0.2 1</size></box></geometry></collision>
      <collision name="pillar"><pose>3.8 3.1 0.5 0 0 0</pose><geometry><box><size>0.8 0.8 1</size></box></geometry></collision>
      <visual name="north"><pose>0 5 0.5 0 0 0</pose><geometry><box><size>12 0.2 1</size></box></geometry></visual>
      <visual name="south"><pose>0 -5 0.5 0 0 0</pose><geometry><box><size>12 0.2 1</size></box></geometry></visual>
      <visual name="east"><pose>6 0 0.5 0 0 0</pose><geometry><box><size>0.2 10 1</size></box></geometry></visual>
      <visual name="west"><pose>-6 0 0.5 0 0 0</pose><geometry><box><size>0.2 10 1</size></box></geometry></visual>
      <visual name="long_partition"><pose>-2 1.8 0.5 0 0 0</pose><geometry><box><size>0.2 4.8 1</size></box></geometry></visual>
      <visual name="short_partition"><pose>2.5 -1.5 0.5 0 0 0.45</pose><geometry><box><size>3.2 0.2 1</size></box></geometry></visual>
      <visual name="pillar"><pose>3.8 3.1 0.5 0 0 0</pose><geometry><box><size>0.8 0.8 1</size></box></geometry></visual>
    </link></model>
  </world>
</sdf>
